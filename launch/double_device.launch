
<launch>
    <arg name="enable_imu_trigger" default="false"/>
    <node pkg="nodelet" type="nodelet" name="vision_nodelet" args="manager"
          output="screen" respawn="true"/>
    <node pkg="nodelet" type="nodelet" name="hk_camera"
          args="load hk_camera/HKCameraNodelet vision_nodelet"
          output="screen" respawn="true">
        <param name="camera_name" value="hk_camera"/>
        <param name="image_width" value="1440"/>
        <param name="image_height" value="1080"/>
        <param name="exposure_auto" value="false"/>
        <param name="exposure_value" value="2500"/>
        <param name="exposure_value_windmill" value="3000"/>

        <param name="pixel_format" value="bgr8"/>
        <param name="camera_info_url" value="file://home/dynamicx/.ros/camera_info/6mm_hk_camera.yaml"/>
        <param name="camera_frame_id" value="camera_optical_frame"/>
        <param name="frame_id" value="camera_optical_frame"/>
        <param name="camera_sn" value="00K36657761"/>
        <param name="frame_rate" value="200"/>
        <param name="enable_imu_trigger" value="$(arg enable_imu_trigger)"/>
        <param name="gain_value" value="16"/>
        <param name="gain_auto" value="false"/>
        <param name="gamma_selector" value="2"/>
        <param name="gamma_value" value="0.7"/>
        <param name="stop_grab" value="false"/>
        <remap from="/image_rect" to="/image_rect" />
        <param name="is_fps_down" value="false"/>
        <param name="target_fps" value="15"/>

    </node>
    <node pkg="nodelet" type="nodelet" name="vision_nodelet_back" args="manager"
          output="screen" respawn="true"/>
    <node pkg="nodelet" type="nodelet" name="hk_camera_back"
          args="load hk_camera/HKCameraNodelet vision_nodelet_back"
          output="screen" respawn="true">
        <param name="camera_name" value="hk_camera_back"/>
        <param name="image_width" value="1280"/>
        <param name="image_height" value="1024"/>
        <param name="exposure_auto" value="false"/>
        <param name="exposure_value" value="1000"/>
        <param name="pixel_format" value="bgr8"/>
        <param name="camera_info_url" value="file://home/dynamicx/.ros/camera_info/camera_left.yaml"/>
        <param name="camera_frame_id" value="camera_optical_frame_back"/>
        <param name="frame_id" value="camera_optical_frame_back"/>
        <param name="camera_sn" value="DA5510091"/>
        <param name="frame_rate" value="30"/>
        <param name="enable_imu_trigger" value="$(arg enable_imu_trigger)"/>
        <param name="gain_value" value="16"/>
        <param name="gain_auto" value="false"/>
        <param name="gamma_selector" value="2"/>
        <param name="gamma_value" value="0.7"/>
        <param name="sleep_time" value="3"/>
        <param name="stop_grab" value="false"/>
        <param name="is_fps_down" value="false"/>
        <param name="target_fps" value="15"/>

        <remap from="/image_rect" to="/image_rect_back" />
    </node>

</launch>
